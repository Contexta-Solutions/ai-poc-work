<mxfile host="65bd71144e">
    <diagram id="approach-1-azure" name="1 — Azure De-ID">
        <mxGraphModel dx="1073" dy="549" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="a0"/>
                <mxCell id="a1" parent="a0"/>
                <mxCell id="atitle" value="&lt;b&gt;APPROACH 1 — Azure Health De-identification&lt;/b&gt;&lt;br&gt;Managed clinical PHI service. Explored first; set aside when Azure stopped being the deployment target." style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" parent="a1" vertex="1">
                    <mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="astatus" value="&lt;b&gt;STATUS: EXPLORED&lt;/b&gt;&lt;br&gt;Not pursued further once&lt;br&gt;Azure stopped being the&lt;br&gt;deployment target." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="a1" vertex="1">
                    <mxGeometry x="1560" y="20" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="abandA" value="&lt;b&gt;LAYER 1 — TRUST BOUNDARIES&lt;/b&gt;&amp;nbsp;&amp;nbsp;who actually sees the patient data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;" parent="a1" vertex="1">
                    <mxGeometry x="40" y="110" width="1820" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="ainfra" value="&lt;b&gt;YOUR INFRASTRUCTURE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#6c8ebf;" parent="a1" vertex="1">
                    <mxGeometry x="70" y="165" width="520" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="aemr" value="&lt;b&gt;Contexta EMR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SOAP notes, lab PDFs,&lt;br&gt;patient demographics&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="a1" vertex="1">
                    <mxGeometry x="100" y="205" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="apy" value="&lt;b&gt;py-backend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;summary/service.py&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="a1" vertex="1">
                    <mxGeometry x="360" y="205" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="aazure" value="&lt;b&gt;Azure Health De-ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MICROSOFT — 3rd party&lt;br&gt;sees RAW PHI&lt;br&gt;cross-border transfer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="a1" vertex="1">
                    <mxGeometry x="700" y="200" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="aclaude" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;3rd party, US&lt;br&gt;sees MASKED text only&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="a1" vertex="1">
                    <mxGeometry x="1060" y="200" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="a1" source="aemr" target="apy" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ae2" value="raw PHI" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;" parent="a1" source="apy" target="aazure" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ae3" value="masked" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontColor=#82b366;" parent="a1" source="aazure" target="aclaude" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="anoteA" value="&lt;b&gt;THEORY — why this was the right call, then wasn&#39;t&lt;/b&gt;&lt;br&gt;&lt;br&gt;The argument was never &quot;Azure is good&quot;. It was: &lt;i&gt;a managed clinical PHI service you are already inside beats one you assemble yourself.&lt;/i&gt;&lt;br&gt;&lt;br&gt;When you deploy on Azure the orange box is intra-region, under a BAA you already hold, zero egress.&lt;br&gt;&lt;br&gt;When you don&#39;t, the same box becomes a NEW vendor, a NEW DPA, and a cross-border transfer under DPDP §16 — for a service you otherwise have no relationship with." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="a1" vertex="1">
                    <mxGeometry x="1380" y="140" width="450" height="215" as="geometry"/>
                </mxCell>
                <mxCell id="abandB" value="&lt;b&gt;LAYER 2 — TECHNICAL FLOW&lt;/b&gt;&amp;nbsp;&amp;nbsp;the actual API contract (verified against REST spec 2024-11-15)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;" parent="a1" vertex="1">
                    <mxGeometry x="40" y="400" width="1820" height="560" as="geometry"/>
                </mxCell>
                <mxCell id="ap1" value="Lab PDF /&lt;br&gt;SOAP note" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="a1" vertex="1">
                    <mxGeometry x="80" y="460" width="130" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ap2" value="PyMuPDF&lt;br&gt;extract text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="a1" vertex="1">
                    <mxGeometry x="250" y="460" width="130" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ap3" value="&lt;b&gt;POST /deid&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;operation: Tag&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="a1" vertex="1">
                    <mxGeometry x="420" y="460" width="150" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ap4" value="entities[]&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;category + offsets&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="a1" vertex="1">
                    <mxGeometry x="610" y="460" width="150" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ap5" value="&lt;b&gt;selective redact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;client-side, KEEP Age+Date&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="a1" vertex="1">
                    <mxGeometry x="800" y="460" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ap6" value="Claude" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="a1" vertex="1">
                    <mxGeometry x="1010" y="460" width="110" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="af1" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="a1" source="ap1" target="ap2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="af2" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="a1" source="ap2" target="ap3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="af3" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="a1" source="ap3" target="ap4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="af4" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="a1" source="ap4" target="ap5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="af5" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="a1" source="ap5" target="ap6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="areq" value="&lt;b&gt;REQUEST&lt;/b&gt;&amp;nbsp;&amp;nbsp;POST {endpoint}/deid?api-version=2024-11-15&lt;br&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;inputText&quot;: &quot;...&quot;,&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#999999&quot;&gt;// max 48,000 chars&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;operation&quot;: &quot;Tag&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;customizations&quot;: { &quot;redactionFormat&quot;: &quot;[{type}]&quot; }&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Exactly 3 fields. Anything else is rejected.&lt;/font&gt;&lt;br&gt;&lt;b&gt;Auth: Entra ID&lt;/b&gt; (NOT an API key)&lt;br&gt;scope https://deid.azure.com/.default" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontFamily=Courier New;" parent="a1" vertex="1">
                    <mxGeometry x="80" y="570" width="500" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="ares" value="&lt;b&gt;RESPONSE&lt;/b&gt;&lt;br&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;outputText&quot;: &quot;...&quot;,&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#999999&quot;&gt;// Redact/Surrogate only&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;taggerResult&quot;: { &quot;entities&quot;: [ {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;category&quot;, &quot;text&quot;, &quot;confidenceScore&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;offset&quot;: {codePoint, utf16, utf8},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;length&quot;: {codePoint, utf16, utf8}&lt;br&gt;&amp;nbsp;&amp;nbsp;} ] }&lt;br&gt;}&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;offset/length are OBJECTS, not ints.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Python must use codePoint.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontFamily=Courier New;" parent="a1" vertex="1">
                    <mxGeometry x="610" y="570" width="510" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="aops" value="&lt;b&gt;THE THREE OPERATIONS — and why we chose Tag&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Tag&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;locate entities + offsets, text unchanged&lt;br&gt;&lt;b&gt;Redact&lt;/b&gt;&amp;nbsp;&amp;nbsp;replace with [category] markers&lt;br&gt;&lt;b&gt;Surrogate&lt;/b&gt;&amp;nbsp;&amp;nbsp;replace with realistic fake values&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;Server-side Redact breaks the summariser.&lt;/b&gt;&lt;/font&gt; 2024-11-15 exposes only&lt;br&gt;redactionFormat + surrogateLocale — &lt;b&gt;there is no category allow-list&lt;/b&gt;.&lt;br&gt;Microsoft&#39;s own example:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;Kimberly Brown is a 34 y.o. ... PCP 2/6/2025 Dr. Orlo&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;→ &quot;[patient] is a &lt;font color=&quot;#b85450&quot;&gt;[age]&lt;/font&gt; y.o. ... PCP &lt;font color=&quot;#b85450&quot;&gt;[date]&lt;/font&gt; [doctor]&quot;&lt;br&gt;&lt;br&gt;Age and date both go. The Contexta prompt asks Claude for trends&lt;br&gt;over time and doses by age. &lt;b&gt;Hence Tag + client-side redaction.&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="a1" vertex="1">
                    <mxGeometry x="1160" y="440" width="480" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="afacts" value="&lt;b&gt;KEY FACTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;28&lt;/b&gt; PhiCategory values&lt;br&gt;&amp;nbsp;&amp;nbsp;Patient, Doctor, MedicalRecord,&lt;br&gt;&amp;nbsp;&amp;nbsp;Hospital, HealthPlan, Age, Date...&lt;br&gt;&lt;br&gt;• &lt;b&gt;48,000&lt;/b&gt; char input limit&lt;br&gt;&amp;nbsp;&amp;nbsp;(chunking a non-issue)&lt;br&gt;&lt;br&gt;• &lt;b&gt;50 MB/month free&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;≈ 10,000 summaries&lt;br&gt;&lt;br&gt;• RBAC roles required:&lt;br&gt;&amp;nbsp;&amp;nbsp;DeID Data Owner&lt;br&gt;&amp;nbsp;&amp;nbsp;DeID Real-Time Data User&lt;br&gt;&lt;br&gt;• &lt;b&gt;Cannot&lt;/b&gt; express Aadhaar,&lt;br&gt;&amp;nbsp;&amp;nbsp;ABHA, UHID, PAN — a custom&lt;br&gt;&amp;nbsp;&amp;nbsp;regex layer is needed anyway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="a1" vertex="1">
                    <mxGeometry x="1660" y="440" width="190" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="agap" value="&lt;b&gt;⚠ NOT COVERED BY ANY TEXT DE-ID&lt;/b&gt;&amp;nbsp;&amp;nbsp;— base64 images in service.py:169 go to Claude&#39;s vision API completely raw. HIPAA identifier #17 (full-face photographs). Needs OCR-then-redact, or strip images entirely. Unsolved in both approaches." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" parent="a1" vertex="1">
                    <mxGeometry x="80" y="790" width="1040" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="abugs" value="&lt;b&gt;BUGS FOUND BY READING THE SPEC&lt;/b&gt;&amp;nbsp;&amp;nbsp;(deid_spike.py, all fixed)&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Invented field&lt;/b&gt; — was sending &quot;dataType&quot;: &quot;Plaintext&quot;. Not in the spec; would 400.&lt;br&gt;2. &lt;b&gt;Offsets are StringIndex objects&lt;/b&gt; — treated as ints; would mis-slice on non-BMP characters.&lt;br&gt;3. &lt;b&gt;Design flaw&lt;/b&gt; — recommended server-side Redact, which silently strips Age and Date." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="a1" vertex="1">
                    <mxGeometry x="80" y="870" width="1040" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="approach-2-presidio" name="2 — Presidio ">
        <mxGraphModel dx="1065" dy="545" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0">
            <root>
                <mxCell id="b0"/>
                <mxCell id="b1" parent="b0"/>
                <mxCell id="btitle" value="&lt;b&gt;APPROACH 2 — Presidio, self-hosted&lt;/b&gt;&lt;br&gt;In-process detection. PHI never leaves your infrastructure. The approach taken furthest — not a decision." style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" parent="b1" vertex="1">
                    <mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="bstatus" value="&lt;b&gt;STATUS: EXPLORED FURTHEST&lt;/b&gt;&lt;br&gt;33/33 tests passing&lt;br&gt;Measured on real lab PDFs&lt;br&gt;NOT a decision" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="b1" vertex="1">
                    <mxGeometry x="1560" y="20" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="bbandA" value="&lt;b&gt;LAYER 1 — TRUST BOUNDARIES&lt;/b&gt;&amp;nbsp;&amp;nbsp;nothing crosses until it is already masked" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;" parent="b1" vertex="1">
                    <mxGeometry x="40" y="110" width="1820" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="binfra" value="&lt;b&gt;YOUR INFRASTRUCTURE&lt;/b&gt;&amp;nbsp;&amp;nbsp;— detection happens entirely in-process" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#6c8ebf;" parent="b1" vertex="1">
                    <mxGeometry x="70" y="160" width="1000" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="bemr" value="&lt;b&gt;Lab PDF /&lt;br&gt;SOAP note&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="b1" vertex="1">
                    <mxGeometry x="100" y="195" width="150" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="bpres" value="&lt;b&gt;contexta_redact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Presidio + custom recognizers&lt;br&gt;spaCy or clinical transformer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="b1" vertex="1">
                    <mxGeometry x="330" y="195" width="230" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="bmask" value="&lt;b&gt;masked text&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[PERSON] [IN_AADHAAR]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="b1" vertex="1">
                    <mxGeometry x="640" y="195" width="170" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="bclaude" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;only 3rd party&lt;br&gt;masked text only&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="b1" vertex="1">
                    <mxGeometry x="1130" y="195" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="bE1" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="b1" source="bemr" target="bpres" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bE2" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="b1" source="bpres" target="bmask" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bE3" value="masked" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontColor=#82b366;" parent="b1" source="bmask" target="bclaude" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bnoteA" value="&lt;b&gt;THEORY — why this wins without Azure&lt;/b&gt;&lt;br&gt;&lt;br&gt;One trust boundary instead of two. Free. No new vendor, no new DPA, no cross-border transfer of raw PHI.&lt;br&gt;&lt;br&gt;&lt;b&gt;The cost:&lt;/b&gt; you now own detection accuracy. There is no vendor to escalate to when it misses a name — which is why every score has a test behind it." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="b1" vertex="1">
                    <mxGeometry x="1400" y="150" width="440" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="bbandB" value="&lt;b&gt;LAYER 2 — THE PIPELINE&lt;/b&gt;&amp;nbsp;&amp;nbsp;two passes over two views of the page" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;" parent="b1" vertex="1">
                    <mxGeometry x="40" y="350" width="1820" height="480" as="geometry"/>
                </mxCell>
                <mxCell id="bq1" value="&lt;b&gt;PDF&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="b1" vertex="1">
                    <mxGeometry x="80" y="470" width="90" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="bq2" value="&lt;b&gt;pdf.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;get_text(&quot;blocks&quot;)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="b1" vertex="1">
                    <mxGeometry x="210" y="470" width="140" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="bpass1" value="&lt;b&gt;PASS 1 — per block&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;all recognizers + NER&lt;br&gt;spans cannot cross columns&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="b1" vertex="1">
                    <mxGeometry x="390" y="415" width="190" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="bpass2" value="&lt;b&gt;PASS 2 — joined page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;label anchors only&lt;br&gt;restores label↔value adjacency&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="b1" vertex="1">
                    <mxGeometry x="390" y="510" width="190" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="bfilter" value="&lt;b&gt;min_span_chars&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;drop 1-char noise&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="b1" vertex="1">
                    <mxGeometry x="620" y="470" width="140" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="bmerge" value="&lt;b&gt;merge_overlaps&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(spans, text)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="b1" vertex="1">
                    <mxGeometry x="800" y="470" width="140" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="bout1" value="masked text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="b1" vertex="1">
                    <mxGeometry x="1000" y="395" width="150" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="bout2" value="entity table" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="b1" vertex="1">
                    <mxGeometry x="1000" y="450" width="150" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="bout3" value="redacted PDF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="b1" vertex="1">
                    <mxGeometry x="1000" y="505" width="150" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="bout4" value="JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="b1" vertex="1">
                    <mxGeometry x="1000" y="560" width="150" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="bg1" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="b1" source="bq1" target="bq2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bg2" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="b1" source="bq2" target="bpass1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bg3" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="b1" source="bq2" target="bpass2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bg4" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="b1" source="bpass1" target="bfilter" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bg5" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="b1" source="bpass2" target="bfilter" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bg6" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="b1" source="bfilter" target="bmerge" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bg7" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="b1" source="bmerge" target="bout2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bnote2pass" value="&lt;b&gt;THEORY — why TWO passes&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Blocks fix the units problem.&lt;/b&gt; In the flat stream a lab report reads&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;...&amp;lt;34 U/L\nAspartate Aminotransferase...&lt;/font&gt;&lt;br&gt;The unit ends one line, the next test begins the following one, so NER spans the newline and reports &lt;font face=&quot;Courier New&quot;&gt;U/L\nAspartate Aminotransferase&lt;/font&gt; as one ORGANIZATION. That is why &lt;b&gt;mg/dL and U/L were being redacted&lt;/b&gt; — they were never targeted, just swallowed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Joined page fixes label anchoring.&lt;/b&gt; PDF forms put label and value in SEPARATE blocks — block 45 is &lt;font face=&quot;Courier New&quot;&gt;&#39;Name\n:&#39;&lt;/font&gt;, block 47 is &lt;font face=&quot;Courier New&quot;&gt;&#39;MRS.NAGA LAXMI J&#39;&lt;/font&gt;. Per block, &lt;font face=&quot;Courier New&quot;&gt;Patient Name:&lt;/font&gt; and the name never co-occur.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;Per-block only → the patient&#39;s name leaks.&lt;br&gt;Joined only → the units get swallowed.&lt;/b&gt;&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;size=16;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="b1" vertex="1">
                    <mxGeometry x="1200" y="380" width="470" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="bdet" value="&lt;b&gt;THE THREE DETECTOR LAYERS&lt;/b&gt;&amp;nbsp;&amp;nbsp;— complementary failure modes, which is the point" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#9673a6;" parent="b1" vertex="1">
                    <mxGeometry x="80" y="620" width="1080" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="bd1" value="&lt;b&gt;1. Custom recognizers&lt;/b&gt;&amp;nbsp;&amp;nbsp;(regex, ~0ms, deterministic)&lt;br&gt;&lt;br&gt;IN_AADHAAR (Verhoeff-validated) · IN_PAN (holder-type check) ·&lt;br&gt;IN_ABHA_NUMBER · IN_ABHA_ADDRESS · IN_PHONE · IN_PIN_CODE ·&lt;br&gt;IN_UHID · IN_VEHICLE_REG · IN_INSURANCE_ID ·&lt;br&gt;IN_PATIENT_NAME · IN_DOCTOR_NAME · IN_PERSON_NAME&lt;br&gt;&lt;br&gt;&lt;b&gt;Catches:&lt;/b&gt; anything with a format. &lt;b&gt;Cannot catch:&lt;/b&gt; names in prose." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="b1" vertex="1">
                    <mxGeometry x="100" y="660" width="400" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="bd2" value="&lt;b&gt;2. NER engine&lt;/b&gt;&amp;nbsp;&amp;nbsp;(statistical, swappable)&lt;br&gt;&lt;br&gt;&lt;b&gt;spaCy en_core_web_lg&lt;/b&gt; — fast, general-purpose,&lt;br&gt;trained on news/web. Needs the allow-list.&lt;br&gt;&lt;br&gt;&lt;b&gt;StanfordAIMI/stanford-deidentifier-base&lt;/b&gt; — clinical&lt;br&gt;de-id model, ~10× slower, needs no allow-list for&lt;br&gt;clinical vocabulary.&lt;br&gt;&lt;br&gt;&lt;b&gt;Catches:&lt;/b&gt; names, places, dates. &lt;b&gt;Cannot catch:&lt;/b&gt; Aadhaar." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="b1" vertex="1">
                    <mxGeometry x="520" y="660" width="330" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="bd3" value="&lt;b&gt;3. Allow-list&lt;/b&gt;&amp;nbsp;&amp;nbsp;(suppression)&lt;br&gt;&lt;br&gt;UNITS · LAB_TESTS · LAB_METHODS ·&lt;br&gt;REPORT_TERMS · FORM_ABBREVIATIONS ·&lt;br&gt;COMMON_DRUGS&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Treats the symptom, not the cause.&lt;br&gt;Only covers what you enumerate.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="b1" vertex="1">
                    <mxGeometry x="870" y="660" width="270" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="bbandC" value="&lt;b&gt;LAYER 3 — MEASURED RESULTS&lt;/b&gt;&amp;nbsp;&amp;nbsp;on a real Tenet Diagnostics LFT report (25BNJH0012386_d.pdf)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;" parent="b1" vertex="1">
                    <mxGeometry x="40" y="860" width="1820" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="bres1" value="&lt;b&gt;BEFORE&lt;/b&gt;&amp;nbsp;&amp;nbsp;spaCy, flat extraction, no allow-list&lt;br&gt;&lt;br&gt;26 detections, &lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;16 false positives&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Alanine Aminotransferase → PERSON&lt;br&gt;Alkaline Phosphatase → PERSON&lt;br&gt;Biuret, GCNA → PERSON&lt;br&gt;Bromocresol Green, PNPP, BCG → ORGANIZATION&lt;br&gt;U/L\Gamma GT, dL\Direct Bilirubin → ORGANIZATION&lt;br&gt;Reg.No, Req.No → URL (.no = Norway)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;Patient name NOT detected at all.&lt;/b&gt;&lt;br&gt;Only partially blacked out because&lt;br&gt;&quot;MRS.NA&quot; looked like a Namibian domain.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="b1" vertex="1">
                    <mxGeometry x="80" y="910" width="420" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="bres2" value="&lt;b&gt;AFTER&lt;/b&gt;&amp;nbsp;&amp;nbsp;blocks + allow-list + label anchors&lt;br&gt;&lt;br&gt;14 detections, &lt;b&gt;2 harmless label FPs&lt;/b&gt;&lt;br&gt;&lt;br&gt;✓ All lab tests, methods and units preserved&lt;br&gt;✓ Patient name caught (IN_PERSON_NAME)&lt;br&gt;✓ Doctor caught&lt;br&gt;✓ Record number caught&lt;br&gt;&lt;br&gt;&lt;b&gt;Redacted PDF boxes: 164 → 33&lt;/b&gt;&lt;br&gt;&lt;br&gt;PHI probe on output file:&lt;br&gt;NAGA, LAXMI, Asif, Abdur, RAJASHEKAR,&lt;br&gt;25BNJH0012386, UMR2162620, 30644477 — &lt;b&gt;all gone&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="b1" vertex="1">
                    <mxGeometry x="530" y="910" width="420" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="bres3" value="&lt;b&gt;spaCy vs CLINICAL TRANSFORMER&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Transformer found 3 identifiers spaCy MISSED:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;25BNJH0012386&amp;nbsp;&amp;nbsp;(ID 1.00)&lt;br&gt;&amp;nbsp;&amp;nbsp;30644477&amp;nbsp;&amp;nbsp;(ID 0.98)&lt;br&gt;&amp;nbsp;&amp;nbsp;FMR/78102&amp;nbsp;&amp;nbsp;(0.69)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;25BNJH0012386 is the accession number —&lt;br&gt;literally the filename. spaCy leaked it.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Cost:&lt;/b&gt; fragmentation (GRatio, Colony, Tenet),&lt;br&gt;silent &quot;can&#39;t be aligned&quot; drops, ~10× slower.&lt;br&gt;&lt;br&gt;&lt;b&gt;Over-redaction is annoying.&lt;br&gt;Under-redaction is a breach.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="b1" vertex="1">
                    <mxGeometry x="980" y="910" width="420" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="bres4" value="&lt;b&gt;BUGS FOUND &amp;amp; FIXED&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Runaway text search&lt;/b&gt;&lt;br&gt;PERSON &#39;A&#39; matched 118 rects, ID &#39;-&#39; 17.&lt;br&gt;135 of 164 boxes. Blacked out every letter&lt;br&gt;A in the document.&lt;br&gt;&lt;i&gt;Fix: min_span_chars + MAX_RECTS_PER_SPAN&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Stale .text after merge&lt;/b&gt; &lt;font color=&quot;#b85450&quot;&gt;(PHI LEAK)&lt;/font&gt;&lt;br&gt;Merged span kept the winner&#39;s short text.&lt;br&gt;PDF searches by .text → &quot;Asif&quot; stayed readable.&lt;br&gt;&lt;i&gt;Fix: merge_overlaps rebuilds from range&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3. redact_blocks bypassed analyze()&lt;/b&gt;&lt;br&gt;Both fixes missed the CLI path.&lt;br&gt;&lt;i&gt;Fix: guards applied on both paths&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="b1" vertex="1">
                    <mxGeometry x="1430" y="910" width="410" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="bopen" value="&lt;b&gt;STILL OPEN&lt;/b&gt;&amp;nbsp;&amp;nbsp;· images bypass all text de-id (HIPAA #17) · transformer fragmentation: GRatio 0.99, Towers, Tenet · &quot;can&#39;t be aligned&quot; warnings silently DROP detections · allow-list only matches whole spans, not fragments · run all 8 sample PDFs before trusting · seed COMMON_DRUGS from core.patient_medications" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" parent="b1" vertex="1">
                    <mxGeometry x="80" y="1170" width="1760" height="50" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="how-presidio-works" name="3 — How Presidio Works">
        <mxGraphModel dx="1065" dy="545" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="p0"/>
                <mxCell id="p1" parent="p0"/>
                <mxCell id="ptitle" value="&lt;b&gt;HOW PRESIDIO ACTUALLY WORKS&lt;/b&gt;&lt;br&gt;Read from presidio-analyzer 2.2.364 source, not from the docs." style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" parent="p1" vertex="1">
                    <mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ppkg" value="&lt;b&gt;TWO INDEPENDENT PACKAGES&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;presidio-analyzer&lt;/b&gt; FINDS PII → RecognizerResult(entity_type, start, end, score)&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;presidio-anonymizer&lt;/b&gt; REPLACES it, given text + results + operators&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;We use the analyzer and do our own replacement in RedactionPipeline._apply(), because the PDF writer needs the ORIGINAL spans — the anonymizer only returns new ones.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;" parent="p1" vertex="1">
                    <mxGeometry x="40" y="90" width="1820" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ppipe" value="&lt;b&gt;THE analyze() PIPELINE&lt;/b&gt;&amp;nbsp;&amp;nbsp;— 7 stages, in this exact order" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;" parent="p1" vertex="1">
                    <mxGeometry x="40" y="175" width="900" height="700" as="geometry"/>
                </mxCell>
                <mxCell id="pin" value="text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="p1" vertex="1">
                    <mxGeometry x="80" y="215" width="330" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="ps1" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp;&amp;nbsp;registry.get_recognizers(language, entities)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;which recognizers are eligible for this call&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="80" y="271" width="330" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="ps2" value="&lt;b&gt;2&lt;/b&gt;&amp;nbsp;&amp;nbsp;nlp_engine.process_text(text) → &lt;b&gt;NlpArtifacts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tokens · lemmas · NER entities&amp;nbsp;&amp;nbsp;— ONCE, shared by all&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=11;strokeWidth=2;" parent="p1" vertex="1">
                    <mxGeometry x="80" y="343" width="330" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="ps3" value="&lt;b&gt;3&lt;/b&gt;&amp;nbsp;&amp;nbsp;for r in recognizers: r.analyze(text, entities, nlp_artifacts)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ raw RecognizerResult[]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="80" y="415" width="330" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="ps4" value="&lt;b&gt;4&lt;/b&gt;&amp;nbsp;&amp;nbsp;_enhance_using_context()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;context words RAISE the score of matches already found&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;strokeWidth=2;" parent="p1" vertex="1">
                    <mxGeometry x="80" y="487" width="330" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="ps5" value="&lt;b&gt;5&lt;/b&gt;&amp;nbsp;&amp;nbsp;__remove_low_scores(score_threshold)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="80" y="559" width="330" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="ps6" value="&lt;b&gt;6&lt;/b&gt;&amp;nbsp;&amp;nbsp;remove_duplicates()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="80" y="621" width="330" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="ps7" value="&lt;b&gt;7&lt;/b&gt;&amp;nbsp;&amp;nbsp;_remove_allow_list()&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#b85450&quot;&gt;LAST&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="80" y="683" width="330" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="pout" value="&lt;b&gt;RecognizerResult[]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="p1" vertex="1">
                    <mxGeometry x="80" y="745" width="330" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pf0" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="p1" source="pin" target="ps1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pf1" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="p1" source="ps1" target="ps2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pf2" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="p1" source="ps2" target="ps3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pf3" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="p1" source="ps3" target="ps4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pf4" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="p1" source="ps4" target="ps5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pf5" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="p1" source="ps5" target="ps6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pf6" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="p1" source="ps6" target="ps7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pf7" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="p1" source="ps7" target="pout" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pn2" value="&lt;b&gt;THE KEY STAGE.&lt;/b&gt; The NLP engine runs ONCE and every recognizer reads the same artifacts.&lt;br&gt;&lt;br&gt;This is why swapping spaCy → Stanford changes PERSON / LOCATION / DATE_TIME but leaves IN_AADHAAR untouched — the custom regex recognizers never consult NER at all." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="450" y="330" width="440" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="pn56" value="&lt;b&gt;ORDER IS DELIBERATE.&lt;/b&gt; Low-score filtering happens BEFORE dedup — a source comment notes that recognizer-specific thresholds would otherwise be lost when duplicate spans collapse.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Allow-list is applied LAST, after everything else.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="450" y="580" width="440" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="pkinds" value="&lt;b&gt;THREE KINDS OF RECOGNIZER&lt;/b&gt;&amp;nbsp;&amp;nbsp;— all called identically at stage 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;" parent="p1" vertex="1">
                    <mxGeometry x="970" y="175" width="890" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="pk1" value="&lt;b&gt;1. PatternRecognizer&lt;/b&gt;&amp;nbsp;&amp;nbsp;regex + optional validation hook&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Pattern(name=&quot;aadhaar&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;regex=r&quot;\b[2-9]\d{3}[\s-]?\d{4}[\s-]?\d{4}\b&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;score=0.5)&lt;br&gt;&lt;br&gt;def validate_result(self, pattern_text):&lt;br&gt;&amp;nbsp;&amp;nbsp;return verhoeff_valid(digits)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;True&lt;/b&gt; → promote to 1.0&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;False&lt;/b&gt; → discard&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;None&lt;/b&gt; → leave&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;This hook is why 2345 6789 0127 was REJECTED and&lt;br&gt;…0124 accepted. Without it, any 12 digits match.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="1000" y="215" width="410" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="pk2" value="&lt;b&gt;2. EntityRecognizer / LocalRecognizer&lt;/b&gt;&lt;br&gt;&lt;br&gt;You implement load() and analyze() yourself.&lt;br&gt;&lt;br&gt;Our &lt;b&gt;LabelAnchoredRecognizer&lt;/b&gt; uses this so it can return ONLY the named capture group:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;start, end = match.span(&quot;value&quot;)&lt;/font&gt;&lt;br&gt;&lt;br&gt;PatternRecognizer would report the WHOLE match — redacting the label too, destroying the document structure a summariser reads." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="1430" y="215" width="410" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="pk3" value="&lt;b&gt;3. NLP-engine-backed&lt;/b&gt;&amp;nbsp;&amp;nbsp;SpacyRecognizer / TransformersRecognizer&lt;br&gt;&lt;br&gt;These do NO pattern matching. They read &lt;font face=&quot;Courier New&quot;&gt;nlp_artifacts.entities&lt;/font&gt; and translate the model&#39;s own labels into Presidio entity names — that translation is our &lt;b&gt;TRANSFORMER_ENTITY_MAPPING&lt;/b&gt;: PATIENT→PERSON, HOSP→ORGANIZATION, DATE→DATE_TIME …&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;A label you do not map is silently dropped.&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;+ ~50 predefined&lt;/b&gt; (credit card, IBAN, US_SSN, EMAIL, URL…) — the URL one is what read &lt;font face=&quot;Courier New&quot;&gt;Reg.No&lt;/font&gt; as a Norwegian domain and &lt;font face=&quot;Courier New&quot;&gt;MRS.NA&lt;/font&gt; as a Namibian one." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="1000" y="455" width="840" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="pscore" value="&lt;b&gt;SCORING — how context works, with our real numbers&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;" parent="p1" vertex="1">
                    <mxGeometry x="970" y="615" width="890" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="psc1" value="&lt;b&gt;Context words do not SELECT matches.&lt;br&gt;They raise the confidence of matches already found.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;context_similarity_factor&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= 0.35&amp;nbsp;&amp;nbsp;← the boost&lt;br&gt;min_score_with_context_similarity = 0.4&amp;nbsp;&amp;nbsp;&amp;nbsp;← floor after boost&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="1000" y="655" width="500" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="psc2" value="&lt;b&gt;WORKED EXAMPLE — IN_PIN_CODE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;base score&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0.25&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;font color=&quot;#666666&quot;&gt;below 0.35 threshold — invisible&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&quot;PIN code:&quot; nearby&amp;nbsp;&amp;nbsp;+0.35&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;─────&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;0.60&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#82b366&quot;&gt;← exactly what the run printed&lt;/font&gt;&lt;br&gt;&lt;br&gt;500034 alone is a bill amount. Next to &quot;PIN&quot; it is an identifier." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="1000" y="775" width="500" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="psc3" value="&lt;b&gt;Why the test exists&lt;/b&gt;&lt;br&gt;&lt;br&gt;test_pin_code_below_threshold_&lt;br&gt;without_context pins the BARE score.&lt;br&gt;&lt;br&gt;Tests run with nlp_artifacts=None, so context boosting is OFF — which makes the raw 0.25 directly assertable.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;If it starts failing, precision has been traded away somewhere.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="1520" y="655" width="320" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="pint" value="&lt;b&gt;WHERE OUR CODE ATTACHES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;analyzer = AnalyzerEngine(nlp_engine=…, supported_languages=[&quot;en&quot;])&lt;br&gt;for recognizer in build_indian_recognizers():&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;analyzer.registry.add_recognizer(recognizer)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;font color=&quot;#666666&quot;&gt;← stage 1 registry&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;That is the entire integration surface.&lt;/b&gt; Everything else — merge_overlaps, min_span_chars, the two-pass block handling, the PDF writer — sits OUTSIDE Presidio, because &lt;b&gt;Presidio has no concept of PDF layout&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="40" y="900" width="900" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="pgotcha" value="&lt;b&gt;⚠ THE ALLOW-LIST GOTCHA — still open on tab 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;allow_list_match&lt;/font&gt; defaults to &lt;b&gt;&quot;exact&quot;&lt;/b&gt; — it compares against the &lt;b&gt;WHOLE detected span&lt;/b&gt;.&lt;br&gt;&lt;br&gt;That is precisely why &lt;font face=&quot;Courier New&quot;&gt;A/GRatio&lt;/font&gt; sitting in LAB_TESTS did NOT stop the transformer&#39;s &lt;font face=&quot;Courier New&quot;&gt;GRatio&lt;/font&gt; (0.99) from firing: the detected span was the &lt;i&gt;fragment&lt;/i&gt;, not the full term.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;Fix:&lt;/b&gt; allow_list_match=&quot;regex&quot; matches substrings. One parameter, no new code — try this before anything more elaborate.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;size=16;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;" parent="p1" vertex="1">
                    <mxGeometry x="970" y="900" width="890" height="150" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="structure-files" name="4 — Structure &amp; Files">
        <mxGraphModel dx="1295" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0">
            <root>
                <mxCell id="c0"/>
                <mxCell id="c1" parent="c0"/>
                <mxCell id="ctitle" value="&lt;b&gt;STRUCTURE &amp;amp; FILES&lt;/b&gt;&lt;br&gt;What lives where, and what each module is responsible for." style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" parent="c1" vertex="1">
                    <mxGeometry x="40" y="20" width="1300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ctree" value="&lt;b&gt;security/&lt;/b&gt;&lt;br&gt;├── &lt;b&gt;redact.py&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;CLI — approach 2&lt;/font&gt;&lt;br&gt;├── &lt;b&gt;deid_spike.py&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;CLI — approach 1&lt;/font&gt;&lt;br&gt;├── &lt;b&gt;contexta_redact/&lt;/b&gt;&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├── __init__.py&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├── &lt;b&gt;recognizers.py&lt;/b&gt;&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├── &lt;b&gt;engine.py&lt;/b&gt;&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├── &lt;b&gt;allowlist.py&lt;/b&gt;&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├── &lt;b&gt;pdf.py&lt;/b&gt;&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;└── &lt;b&gt;report.py&lt;/b&gt;&lt;br&gt;├── tests/test_recognizers.py&lt;br&gt;├── sample_pdf/&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;8 real lab reports&lt;/font&gt;&lt;br&gt;├── requirements.txt&lt;br&gt;├── requirements-transformers.txt&lt;br&gt;├── .gitignore&lt;br&gt;└── .venv/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;fontFamily=Courier New;" parent="c1" vertex="1">
                    <mxGeometry x="40" y="110" width="360" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="cm1" value="&lt;b&gt;recognizers.py&lt;/b&gt;&amp;nbsp;&amp;nbsp;— what Presidio cannot know&lt;br&gt;&lt;br&gt;&lt;b&gt;Verhoeff&lt;/b&gt; verhoeff_valid() / verhoeff_check_digit()&lt;br&gt;&lt;b&gt;PatternRecognizer subclasses&lt;/b&gt; (regex + validate_result)&lt;br&gt;&amp;nbsp;&amp;nbsp;AadhaarRecognizer · PanRecognizer · AbhaNumberRecognizer&lt;br&gt;&amp;nbsp;&amp;nbsp;AbhaAddressRecognizer · IndianPhoneRecognizer&lt;br&gt;&amp;nbsp;&amp;nbsp;IndianPinCodeRecognizer · ContextaUhidRecognizer&lt;br&gt;&amp;nbsp;&amp;nbsp;VehicleRegistrationRecognizer · InsurancePolicyRecognizer&lt;br&gt;&amp;nbsp;&amp;nbsp;HonorificNameRecognizer&lt;br&gt;&lt;b&gt;LocalRecognizer subclasses&lt;/b&gt; (named group → value span only)&lt;br&gt;&amp;nbsp;&amp;nbsp;LabelAnchoredRecognizer (base)&lt;br&gt;&amp;nbsp;&amp;nbsp;PatientNameRecognizer · ReferringDoctorRecognizer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="c1" vertex="1">
                    <mxGeometry x="440" y="110" width="470" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="cm2" value="&lt;b&gt;engine.py&lt;/b&gt;&amp;nbsp;&amp;nbsp;— pipeline assembly, the single source of truth&lt;br&gt;&lt;br&gt;&lt;b&gt;RedactionConfig&lt;/b&gt; model · threshold · keep · drop · nlp_engine&lt;br&gt;&amp;nbsp;&amp;nbsp;transformer_model · allow_list · min_span_chars&lt;br&gt;&lt;b&gt;Span&lt;/b&gt; entity_type · start · end · score · text · marker&lt;br&gt;&lt;b&gt;build_analyzer()&lt;/b&gt; spaCy or TransformersNlpEngine&lt;br&gt;&lt;b&gt;merge_overlaps(spans, text)&lt;/b&gt; collapse + rebuild text&lt;br&gt;&lt;b&gt;RedactionPipeline&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;.analyze() · .redact() · &lt;b&gt;.redact_blocks()&lt;/b&gt; ← the two-pass one&lt;br&gt;&amp;nbsp;&amp;nbsp;.redact_via_anonymizer() ← cross-check&lt;br&gt;&lt;b&gt;TRANSFORMER_MODELS&lt;/b&gt; stanford · obi&lt;br&gt;&lt;b&gt;TRANSFORMER_ENTITY_MAPPING&lt;/b&gt; i2b2 labels → Presidio entities" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="c1" vertex="1">
                    <mxGeometry x="950" y="110" width="470" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="cm3" value="&lt;b&gt;allowlist.py&lt;/b&gt;&amp;nbsp;&amp;nbsp;— never redact these&lt;br&gt;&lt;br&gt;UNITS · LAB_TESTS · LAB_METHODS&lt;br&gt;REPORT_TERMS · FORM_ABBREVIATIONS&lt;br&gt;COMMON_DRUGS&lt;br&gt;&lt;br&gt;clinical_allow_list(extra) → longest-first&lt;br&gt;load_extra_terms(path)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;⚠ Never add a term that could also be&lt;br&gt;a patient&#39;s name — Mercy, Grace, Sunitha&lt;br&gt;are all real Indian given names.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="c1" vertex="1">
                    <mxGeometry x="1460" y="110" width="400" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="cm4" value="&lt;b&gt;pdf.py&lt;/b&gt;&amp;nbsp;&amp;nbsp;— PyMuPDF in and out&lt;br&gt;&lt;br&gt;extract_pages() · extract_text()&lt;br&gt;&lt;b&gt;extract_page_blocks()&lt;/b&gt; ← layout-aware&lt;br&gt;&lt;b&gt;write_redacted_pdf()&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;MIN_NEEDLE_CHARS = 3&lt;br&gt;&amp;nbsp;&amp;nbsp;MAX_RECTS_PER_SPAN = 12&lt;br&gt;&amp;nbsp;&amp;nbsp;PdfRedactionStats: boxes_drawn ·&lt;br&gt;&amp;nbsp;&amp;nbsp;not_located · too_short · runaway&lt;br&gt;&lt;br&gt;&lt;b&gt;apply_redactions() removes glyphs&lt;/b&gt; from the&lt;br&gt;content stream — not a black rectangle drawn&lt;br&gt;on top, which any PDF editor would undo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="c1" vertex="1">
                    <mxGeometry x="440" y="330" width="470" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="cm5" value="&lt;b&gt;report.py&lt;/b&gt;&amp;nbsp;&amp;nbsp;— rendering, stdlib only&lt;br&gt;&lt;br&gt;entity_table(spans, kept)&lt;br&gt;summary_counts(spans)&lt;br&gt;side_by_side(original, redacted, width)&lt;br&gt;to_dict() / to_json()&lt;br&gt;&lt;br&gt;JSON deliberately includes not_located and the&lt;br&gt;kept list: &lt;b&gt;a report that only shows what worked&lt;br&gt;is a report you cannot audit.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="c1" vertex="1">
                    <mxGeometry x="950" y="330" width="470" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="cm6" value="&lt;b&gt;tests/test_recognizers.py&lt;/b&gt;&amp;nbsp;&amp;nbsp;— 32 tests, no spaCy needed&lt;br&gt;&lt;br&gt;Runs with nlp_artifacts=None, so context boosting is OFF&lt;br&gt;and context-gated recognizers are pinned at bare score.&lt;br&gt;&lt;br&gt;&lt;b&gt;Load-bearing tests:&lt;/b&gt;&lt;br&gt;· aadhaar_rejects_bad_checksum&lt;br&gt;· pin_code_below_threshold_without_context&lt;br&gt;· patient_name_does_not_cross_a_newline&lt;br&gt;· merge_overlaps_rebuilds_text_over_merged_range&lt;br&gt;· min_span_chars_rejects_single_character_detections&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;python tests/test_recognizers.py&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="c1" vertex="1">
                    <mxGeometry x="1460" y="330" width="400" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="cm7" value="&lt;b&gt;deid_spike.py&lt;/b&gt;&amp;nbsp;&amp;nbsp;— approach 1, standalone, kept for comparison&lt;br&gt;&lt;br&gt;Raw REST rather than the SDK: the wire contract is the thing worth knowing, and the preview SDK&#39;s Python symbols churn.&lt;br&gt;&lt;br&gt;deidentify(token, text, operation) · _idx() ← StringIndex unwrap · apply_selective_redaction(text, entities, keep) · check_leaks(masked, leaks, keep) · selftest()&lt;br&gt;&lt;br&gt;&lt;b&gt;Its leak counter is the reusable idea&lt;/b&gt; — the only thing in either approach that produces evidence rather than opinion.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;python deid_spike.py --tag | --redact | --surrogate | --raw | --selftest&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="c1" vertex="1">
                    <mxGeometry x="40" y="460" width="870" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="cdep" value="&lt;b&gt;DEPENDENCIES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;requirements.txt&lt;/b&gt;&lt;br&gt;presidio-analyzer 2.2.364 · presidio-anonymizer 2.2.364&lt;br&gt;spacy 3.8.14 · pymupdf 1.28.0&lt;br&gt;+ python -m spacy download en_core_web_lg&lt;br&gt;&lt;br&gt;&lt;b&gt;requirements-transformers.txt&lt;/b&gt; (optional)&lt;br&gt;spacy-huggingface-pipelines 0.0.4 · transformers 4.57.6 · torch 2.13.0&lt;br&gt;+ python -m spacy download en_core_web_sm&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;Gotcha:&lt;/b&gt; Presidio gates on spacy-huggingface-pipelines, NOT transformers.&lt;br&gt;`pip install &quot;transformers&gt;=4.40&quot;` resolves to 5.x and fails with&lt;br&gt;&quot;NLP engine &#39;transformers&#39; is not available&quot;.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" parent="c1" vertex="1">
                    <mxGeometry x="950" y="560" width="910" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="ccmd" value="&lt;b&gt;COMMANDS&lt;/b&gt;&lt;br&gt;&lt;br&gt;.venv\Scripts\activate.bat&lt;br&gt;&lt;br&gt;python redact.py file.pdf&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;# spaCy, blocks, allow-list&lt;/font&gt;&lt;br&gt;python redact.py file.pdf --nlp-engine transformers&lt;br&gt;python redact.py file.pdf --keep DATE_TIME&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;# for the summariser&lt;/font&gt;&lt;br&gt;python redact.py file.pdf --flat&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;# old extraction, to compare&lt;/font&gt;&lt;br&gt;python redact.py file.pdf --threshold 0.6 --drop URL&lt;br&gt;python redact.py file.pdf --json out.json --quiet&lt;br&gt;&lt;br&gt;python tests\test_recognizers.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontFamily=Courier New;" parent="c1" vertex="1">
                    <mxGeometry x="40" y="660" width="870" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="ccomp" value="&lt;b&gt;COMPLIANCE MAPPING&lt;/b&gt;&amp;nbsp;&amp;nbsp;— engineering spec, not legal advice&lt;br&gt;&lt;br&gt;&lt;b&gt;HIPAA (US)&lt;/b&gt; bright line: strip the 18 Safe Harbor identifiers → no longer PHI. Applies only if you handle US patient data.&lt;br&gt;&lt;b&gt;DPDP Act 2023 + Rules 2025 (India)&lt;/b&gt; — Rules notified 14 Nov 2025, phased, full compliance by &lt;b&gt;13 May 2027&lt;/b&gt;. You are a &lt;b&gt;Data Fiduciary&lt;/b&gt;. No prescribed de-identification list; no separate &quot;sensitive data&quot; class. Obligations that bite: consent via registered Consent Managers, Data Principal rights, breach notification. &lt;b&gt;Redaction discharges none of these directly.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Custom recognizer ↔ HIPAA identifier:&lt;/b&gt;&amp;nbsp;&amp;nbsp;#1 names → IN_PATIENT_NAME / IN_PERSON_NAME · #2 geography → IN_PIN_CODE · #3 dates → DATE_TIME · #4 phone → IN_PHONE · #7 SSN → IN_AADHAAR · #8 MRN → IN_UHID / IN_ABHA_NUMBER · #9 health plan → IN_INSURANCE_ID · #11 licence → IN_PAN · #12 vehicle → IN_VEHICLE_REG · #18 other → IN_ABHA_ADDRESS&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;Redaction is defence in depth, not compliance.&lt;/b&gt; It is probabilistic. Your real controls are minimisation (schemas.py already excludes the patient name), the LLM provider agreement, and access control. Cross-border note: sending text to Anthropic&#39;s US API is a transfer under DPDP §16.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;" parent="c1" vertex="1">
                    <mxGeometry x="40" y="890" width="1820" height="230" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
